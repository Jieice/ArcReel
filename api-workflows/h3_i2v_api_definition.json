{
  "kind": "comfyui",
  "schema_version": "1.0.0",
  "meta": {
    "name": "MiniMax H3 图生视频（本机）",
    "author": "Jieice",
    "version": "0.1.0"
  },
  "media_type": "video",
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
        "weight_dtype": "default"
      },
      "_meta": {
        "title": "H3 首尾帧模型 · 剪枝INT8"
      }
    },
    "2": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
        "strength_model": 1
      },
      "_meta": {
        "title": "单个8步加速LoRA · 不叠加其他加速"
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "type": "minimax",
        "device": "default"
      },
      "_meta": {
        "title": "H3 专用文本编码器"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
      },
      "_meta": {
        "title": "视频VAE · 低显存INT8"
      }
    },
    "5": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
      },
      "_meta": {
        "title": "音频VAE"
      }
    },
    "6": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "短剧Q版_首帧.png"
      },
      "_meta": {
        "title": "① 选择确认过的首帧图片"
      }
    },
    "7": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "6",
          0
        ],
        "upscale_method": "lanczos",
        "width": 512,
        "height": 288,
        "crop": "center"
      },
      "_meta": {
        "title": "按输出比例居中裁切 · 保持人物比例"
      }
    },
    "8": {
      "class_type": "MiniMaxH3ImageToVideo",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "prompt": "Locked-off live-action doorbell-camera shot. Preserve the first frame exactly in appearance: one flat 2D chibi girl with dark brown bob hair, teal hoodie, cream skirt and brown boots, standing on the doormat in the photoreal apartment entrance. She blinks naturally once, gently waves her raised right hand twice and makes a tiny happy body sway. Her feet stay planted on the mat. Keep the same face, chibi proportions, flat cel shading, clothes and contact shadow throughout. The real background stays still. No camera movement, no extra characters, no scene cut, no transformation. Quiet outdoor ambience, a soft friendly giggle; no speech, no music, no text.",
        "width": 512,
        "height": 288,
        "length": 56,
        "first_frame": [
          "7",
          0
        ]
      },
      "_meta": {
        "title": "② 写动作 · 眨眼、挥手，镜头固定"
      }
    },
    "9": {
      "class_type": "ModelAttentionBackend",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "attention": "comfy kitchen attention"
      },
      "_meta": {
        "title": "本机已有 Kitchen 注意力后端"
      }
    },
    "10": {
      "class_type": "MiniMaxH3SigmaShift",
      "inputs": {
        "model": [
          "9",
          0
        ],
        "shift_video": 12,
        "shift_audio": 3
      },
      "_meta": {
        "title": "H3 视频/音频采样参数"
      }
    },
    "11": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "10",
          0
        ],
        "conditioning": [
          "8",
          0
        ]
      },
      "_meta": {
        "title": "正向条件引导"
      }
    },
    "12": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": 2026110402
      },
      "_meta": {
        "title": "固定视频种子"
      }
    },
    "13": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler"
      },
      "_meta": {
        "title": "采样器"
      }
    },
    "14": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "10",
          0
        ],
        "scheduler": "simple",
        "steps": 8,
        "denoise": 1
      },
      "_meta": {
        "title": "8步采样 · 先保持默认"
      }
    },
    "15": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "12",
          0
        ],
        "guider": [
          "11",
          0
        ],
        "sampler": [
          "13",
          0
        ],
        "sigmas": [
          "14",
          0
        ],
        "latent_image": [
          "8",
          1
        ]
      },
      "_meta": {
        "title": "③ 生成短镜头"
      }
    },
    "16": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "15",
          0
        ],
        "vae": [
          "4",
          0
        ]
      },
      "_meta": {
        "title": "解码视频帧"
      }
    },
    "17": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "15",
          0
        ],
        "vae": [
          "5",
          0
        ]
      },
      "_meta": {
        "title": "解码同步音频"
      }
    },
    "18": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "16",
          0
        ],
        "fps": 24,
        "audio": [
          "17",
          0
        ],
        "bit_depth": "auto",
        "color_space": "sRGB",
        "codec": "h264"
      },
      "_meta": {
        "title": "24 FPS · H.264视频＋音频"
      }
    },
    "19": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "18",
          0
        ],
        "filename_prefix": "短剧Q版/02_动作预览",
        "format": "auto",
        "codec": "auto"
      },
      "_meta": {
        "title": "④ 保存MP4 · 输出到短剧Q版文件夹"
      }
    }
  },
  "bindings": {
    "prompt": [
      {
        "node": "8",
        "input": "prompt",
        "class_type": "MiniMaxH3ImageToVideo",
        "title": "提示词"
      }
    ],
    "width": [
      {
        "node": "7",
        "input": "width",
        "class_type": "ImageScale",
        "step": 16
      }
    ],
    "height": [
      {
        "node": "7",
        "input": "height",
        "class_type": "ImageScale",
        "step": 16
      }
    ],
    "frames": [
      {
        "node": "8",
        "input": "length",
        "class_type": "MiniMaxH3ImageToVideo"
      }
    ],
    "seed": [
      {
        "node": "12",
        "input": "noise_seed",
        "class_type": "RandomNoise",
        "policy": "random"
      }
    ],
    "start_image": [
      {
        "node": "6",
        "input": "image",
        "class_type": "LoadImage",
        "title": "首帧"
      }
    ],
    "fps": [
      {
        "node": "18",
        "input": "fps",
        "class_type": "CreateVideo",
        "direction": "read"
      }
    ],
    "output": [
      {
        "node": "19",
        "class_type": "SaveVideo",
        "title": "保存视频"
      }
    ]
  }
}